{
	"name": "nopeek",
	"version": "0.0.14",
	"description": "CLI for LLM agent secret safety — load env secrets without exposing values",
	"keywords": [
		"agents",
		"cli",
		"coding-agents",
		"env",
		"llm",
		"redaction",
		"secrets",
		"security"
	],
	"homepage": "https://github.com/spences10/nopeek#readme",
	"bugs": {
		"url": "https://github.com/spences10/nopeek/issues"
	},
	"license": "MIT",
	"author": "Scott Spence <spences10apps@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spences10/nopeek.git"
	},
	"bin": {
		"nopeek": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"start": "node ./dist/index.js",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"format": "vp check --fix",
		"test": "vp test",
		"test:watch": "vp test watch",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish"
	},
	"dependencies": {
		"citty": "^0.2.2"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@types/node": "^25.8.0",
		"vite-plus": "^0.2.0",
		"vitest": "^4.1.6"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@11.15.1"
}

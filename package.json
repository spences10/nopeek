{
	"name": "nopeek",
	"version": "0.0.4",
	"description": "CLI for Claude Code secret safety — secure proxy between Claude Code and your secrets",
	"keywords": [
		"claude",
		"claude-code",
		"cli",
		"env",
		"redaction",
		"secrets",
		"security"
	],
	"license": "MIT",
	"author": "",
	"bin": {
		"nopeek": "./dist/index.js"
	},
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"start": "node ./dist/index.js",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"test": "vp test",
		"test:watch": "vp test watch",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish"
	},
	"dependencies": {
		"chalk": "^5.4.1",
		"citty": "^0.2.1"
	},
	"devDependencies": {
		"@changesets/cli": "^2.30.0",
